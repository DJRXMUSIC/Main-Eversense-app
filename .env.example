# PWA sync API key (available to frontend via Vite)
VITE_SYNC_API_KEY=your-generated-key-here

# Backend sync API key (used by Netlify Functions — set in Netlify dashboard)
# SYNC_API_KEY=your-generated-key-here

# External Nightscout instance (optional — only if using external Nightscout source)
# VITE_NIGHTSCOUT_URL=https://your-nightscout.example.com
# VITE_NIGHTSCOUT_API_SECRET=your-ns-api-secret
